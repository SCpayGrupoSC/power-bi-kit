{
  "name": "Conciliação Spread",
  "dataColors": [
    "#0B3D4A",
    "#1F8A70",
    "#D4A017",
    "#C23B2E",
    "#3E6B8A",
    "#7A8B99",
    "#8B6914",
    "#5C7A6E"
  ],
  "background": "#F3F6F7",
  "foreground": "#14202B",
  "tableAccent": "#0B3D4A",
  "good": "#1F8A70",
  "neutral": "#D4A017",
  "bad": "#C23B2E",
  "maximum": "#0B3D4A",
  "center": "#D4A017",
  "minimum": "#C23B2E",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B3D4A"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#14202B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#14202B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3D4F5F"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F3F6F7" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#E6EBEE" } }
          }
        ]
      }
    },
    "*": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D5DEE3" } },
            "radius": 6
          }
        ],
        "label": [
          {
            "color": { "solid": { "color": "#3D4F5F" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "calloutValue": [
          {
            "color": { "solid": { "color": "#0B3D4A" } },
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D5DEE3" } },
            "radius": 6
          }
        ],
        "cardTitle": [
          {
            "color": { "solid": { "color": "#14202B" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "dataLabels": [
          {
            "color": { "solid": { "color": "#0B3D4A" } },
            "fontSize": 13
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D5DEE3" } },
            "radius": 4
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#3D4F5F" } },
            "textSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#14202B" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "textSize": 11
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D5DEE3" } },
            "radius": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#14202B" } },
            "backColor": { "solid": { "color": "#EAF0F2" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#14202B" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E6EBEE" } },
            "rowPadding": 4,
            "outlineColor": { "solid": { "color": "#D5DEE3" } }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D5DEE3" } },
            "radius": 6
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Right",
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": { "solid": { "color": "#3D4F5F" } }
          }
        ],
        "labels": [
          {
            "show": true,
            "labelStyle": "Data value, percent of total",
            "fontSize": 9,
            "color": { "solid": { "color": "#14202B" } }
          }
        ]
      }
    }
  }
}
