-- ############################################################
--
--   CONCILIAÇÃO SPREAD PREVISTO
--   8 medidas obrigatórias + 5 de texto no apêndice
--
--   REGRA DE OURO: 1 medida = 1 clique em "Nova medida".
--   Nunca cole duas medidas na mesma caixa. Se colar, o Power BI
--   acusa "A sintaxe de X está incorreta".
--
--   Para cada medida abaixo:
--     1. Modelagem → Nova medida
--     2. confira que "Tabela inicial" está em ffechamentoOficial
--     3. copie SÓ o que está entre as linhas =====
--     4. Enter
--     5. repita para a próxima
--
--   Siga a ordem 1 → 8. As de baixo usam as de cima.
--
-- ############################################################
--
--   MODELO REAL DESTE RELATÓRIO
--
--     fPrevisto            → lado previsto
--     ffechamentoOficial   → lado oficial / realizado
--     dFluxoDax[Fluxo]     → MDR | Pix | Antecipação
--     dCompetencia[Competencia] → competência (mês)
--
--   JÁ EXISTEM — NÃO RECRIE:
--     Previsto por Fluxo · Oficial por Fluxo · Diferença
--     Diferença % · Diferença Total · Status Validação
--     Spread Previsto · Spread Oficial
--     Volume Transacionado · Custo Previsto · Transações Previstas
--
-- ############################################################




-- ============================================================
-- MEDIDA 1 de 8 — Diferença Abs
-- Para ordenar a tabela pela maior divergência.
-- Copie as 2 linhas abaixo.
-- ============================================================

Diferença Abs =
ABS ( [Diferença] )

-- ===================== fim da medida 1 ======================




-- ============================================================
-- MEDIDA 2 de 8 — Status Layout
-- O status com o estado "Aguardando".
-- A tolerância é a linha VAR Tol = 0.01 — mude só esse número
-- se a regra do time for outra.
-- Copie as 14 linhas abaixo.
-- ============================================================

Status Layout =
VAR Tol = 0.01
VAR Previsto = [Previsto por Fluxo]
VAR Oficial = [Oficial por Fluxo]
VAR Delta = ABS ( [Diferença] )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Previsto ) && ISBLANK ( Oficial ), "Sem movimento",
        ISBLANK ( Oficial ), "Aguardando",
        ISBLANK ( Previsto ), "Aguardando",
        Delta <= Tol, "OK",
        "Divergente"
    )

-- ===================== fim da medida 2 ======================




-- ============================================================
-- MEDIDA 3 de 8 — Status Cor
-- Cores da marca SCpay: teal no OK, laranja no Aguardando,
-- vermelho do logo na divergência.
--
-- Caminho no cartão: Formatar visual → Visual → Valores →
-- Cor → fx → Estilo do formato: Valor do campo → esta medida.
-- O fx só aparece depois que a medida está no balde Valores.
--
-- Precisa da medida 2.
-- Copie as 8 linhas abaixo.
-- ============================================================

Status Cor =
SWITCH (
    [Status Layout],
    "OK", "#22C5AD",
    "Divergente", "#B82724",
    "Aguardando", "#F07F3C",
    "#8D91A2"
)

-- ===================== fim da medida 3 ======================




-- ============================================================
-- MEDIDA 4 de 8 — Qtd Fluxos OK
-- Conta MDR / Pix / Antecipação, não linhas da tabela fato.
-- Precisa da medida 2.
-- Copie as 4 linhas abaixo. NÃO junte com a medida 5.
-- ============================================================

Qtd Fluxos OK =
COUNTROWS (
    FILTER ( VALUES ( dFluxoDax[Fluxo] ), [Status Layout] = "OK" )
) + 0

-- ===================== fim da medida 4 ======================




-- ============================================================
-- MEDIDA 5 de 8 — Qtd Fluxos Divergente
-- Clique em "Nova medida" ANTES de colar.
-- Copie as 4 linhas abaixo.
-- ============================================================

Qtd Fluxos Divergente =
COUNTROWS (
    FILTER ( VALUES ( dFluxoDax[Fluxo] ), [Status Layout] = "Divergente" )
) + 0

-- ===================== fim da medida 5 ======================




-- ============================================================
-- MEDIDA 6 de 8 — Qtd Fluxos Aguardando
-- Clique em "Nova medida" ANTES de colar.
-- Copie as 4 linhas abaixo.
-- ============================================================

Qtd Fluxos Aguardando =
COUNTROWS (
    FILTER ( VALUES ( dFluxoDax[Fluxo] ), [Status Layout] = "Aguardando" )
) + 0

-- ===================== fim da medida 6 ======================




-- ============================================================
-- MEDIDA 7 de 8 — Status Resumo
-- Texto para a caixa de regras.
-- Precisa das medidas 4, 5 e 6.
-- Copie as 4 linhas abaixo.
-- ============================================================

Status Resumo =
FORMAT ( [Qtd Fluxos OK], "0" ) & " OK  ·  " &
FORMAT ( [Qtd Fluxos Divergente], "0" ) & " divergente  ·  " &
FORMAT ( [Qtd Fluxos Aguardando], "0" ) & " aguardando"

-- ===================== fim da medida 7 ======================




-- ============================================================
-- MEDIDA 8 de 8 — KPI Subtítulo Periodo
-- Texto do título da página.
-- Copie as 3 linhas abaixo.
-- ============================================================

KPI Subtítulo Periodo =
"Conciliação MDR · Pix · Antecipação  —  competência " &
COALESCE ( SELECTEDVALUE ( dCompetencia[Competencia] ), "todas" )

-- ===================== fim da medida 8 ======================




-- ############################################################
--
--   APÊNDICE — MEDIDAS DE TEXTO (9 a 13)
--
--   Use SÓ se o seu Power BI não deixar desligar a abreviação
--   do cartão (aquele "R$ 3,50 Mil" em vez de "R$ 3.503,82").
--
--   Texto não é abreviado. Em troca, texto não ordena por valor
--   e não aceita formatação condicional por número.
--
--   ONDE USAR:  só nos CARTÕES.
--   ONDE NÃO USAR: nas tabelas — lá você precisa da medida
--   numérica original para ordenar por Diferença Abs.
--
--   Mesma regra de sempre: 1 medida = 1 clique em Nova medida.
--
-- ############################################################




-- ============================================================
-- MEDIDA 9 de 13 — Previsto Texto
-- Vai no KPI 1, no lugar de Previsto por Fluxo.
-- ============================================================

Previsto Texto =
IF (
    ISBLANK ( [Previsto por Fluxo] ),
    "—",
    FORMAT ( [Previsto por Fluxo], "R$ #,##0.00" )
)

-- ===================== fim da medida 9 ======================




-- ============================================================
-- MEDIDA 10 de 13 — Oficial Texto
-- Vai no KPI 2, no lugar de Oficial por Fluxo.
-- Enquanto o fechamento não chegar, mostra "—".
-- ============================================================

Oficial Texto =
IF (
    ISBLANK ( [Oficial por Fluxo] ),
    "—",
    FORMAT ( [Oficial por Fluxo], "R$ #,##0.00" )
)

-- ==================== fim da medida 10 ======================




-- ============================================================
-- MEDIDA 11 de 13 — Diferença Texto
-- Vai no KPI 3, no lugar de Diferença.
-- ============================================================

Diferença Texto =
IF (
    ISBLANK ( [Diferença] ),
    "—",
    FORMAT ( [Diferença], "R$ #,##0.00" )
)

-- ==================== fim da medida 11 ======================




-- ============================================================
-- MEDIDA 12 de 13 — Spread Previsto Texto
-- Vai no cartão Spread por fluxo.
-- ============================================================

Spread Previsto Texto =
IF (
    ISBLANK ( [Spread Previsto] ),
    "—",
    FORMAT ( [Spread Previsto], "R$ #,##0.00" )
)

-- ==================== fim da medida 12 ======================




-- ============================================================
-- MEDIDA 13 de 13 — Spread Oficial Texto
-- Vai no cartão Spread por fluxo.
-- ============================================================

Spread Oficial Texto =
IF (
    ISBLANK ( [Spread Oficial] ),
    "—",
    FORMAT ( [Spread Oficial], "R$ #,##0.00" )
)

-- ==================== fim da medida 13 ======================
