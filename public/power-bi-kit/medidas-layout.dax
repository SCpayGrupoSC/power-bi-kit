-- ============================================================
-- Conciliação Spread Previsto — medidas que FALTAM no modelo
-- Power BI Desktop → Modelagem → Nova medida
-- Cole UM bloco por vez (do nome até o último parêntese).
--
-- IMPORTANTE: antes de colar, troque a "Tabela inicial" no topo
-- da barra de fórmula para ffechamentoOficial.
-- ============================================================
--
-- MODELO REAL DESTE RELATÓRIO
--
--   fPrevisto            → lado previsto
--                          Volume Transacionado, Custo Previsto,
--                          Transações Previstas, Venda Prevista,
--                          Spread Previsto
--
--   ffechamentoOficial   → lado oficial / realizado
--                          billing_amount, Cobranças Oficiais,
--                          Spread Oficial, Previsto por Fluxo,
--                          Oficial por Fluxo, Diferença,
--                          Diferença %, Diferença Total,
--                          Status Validação
--
--   dFluxoDax[Fluxo]     → MDR | Pix | Antecipação
--   dCompetencia[Competencia] → competência (mês)
--
-- ============================================================
-- NÃO RECRIE ESTAS — JÁ EXISTEM NO SEU MODELO
--
--   Previsto por Fluxo · Oficial por Fluxo
--   Diferença · Diferença % · Diferença Total
--   Status Validação
--   Spread Previsto · Spread Oficial
--   Volume Transacionado · Custo Previsto · Transações Previstas
--
-- Se colar de novo, o Power BI recusa por nome repetido.
-- ============================================================


-- ------------------------------------------------------------
-- 1) Tolerância. Mude só este número se a regra do time for outra.
-- ------------------------------------------------------------
Tolerância R$ = 0.01


-- ------------------------------------------------------------
-- 2) Diferença absoluta — serve para ordenar a tabela de detalhe
--    da maior divergência para a menor.
-- ------------------------------------------------------------
Diferença Abs =
ABS ( [Diferença] )


-- ------------------------------------------------------------
-- 3) Status com o estado "Aguardando"
--
--    Hoje o seu Status Validação devolve "—" quando o oficial
--    ainda não chegou. Isso confunde: parece divergência quando
--    é só dado que falta.
--
--    Cole como medida NOVA chamada Status Layout, confira, e só
--    depois (se quiser) troque a fórmula do seu Status Validação
--    por esta.
-- ------------------------------------------------------------
Status Layout =
VAR Previsto = [Previsto por Fluxo]
VAR Oficial = [Oficial por Fluxo]
VAR Delta = ABS ( [Diferença] )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Previsto ) && ISBLANK ( Oficial ), "Sem movimento",
        ISBLANK ( Oficial ), "Aguardando",
        ISBLANK ( Previsto ), "Aguardando",
        Delta <= [Tolerância R$], "OK",
        "Divergente"
    )


-- ------------------------------------------------------------
-- 4) Cor do status — use em Formatação condicional → Cor da fonte
--    (escolha "Formato do campo" → esta medida)
-- ------------------------------------------------------------
Status Cor =
SWITCH (
    [Status Layout],
    "OK", "#1F8A70",
    "Divergente", "#C23B2E",
    "Aguardando", "#D4A017",
    "#7A8B99"
)


-- ------------------------------------------------------------
-- 5) Contagem de fluxos por status
--    Conta MDR / Pix / Antecipação, não linhas da tabela fato.
-- ------------------------------------------------------------
Qtd Fluxos OK =
COUNTROWS (
    FILTER ( VALUES ( dFluxoDax[Fluxo] ), [Status Layout] = "OK" )
) + 0

Qtd Fluxos Divergente =
COUNTROWS (
    FILTER ( VALUES ( dFluxoDax[Fluxo] ), [Status Layout] = "Divergente" )
) + 0

Qtd Fluxos Aguardando =
COUNTROWS (
    FILTER ( VALUES ( dFluxoDax[Fluxo] ), [Status Layout] = "Aguardando" )
) + 0


-- ------------------------------------------------------------
-- 6) Textos prontos para os cartões e a caixa de regras
-- ------------------------------------------------------------
Status Resumo =
FORMAT ( [Qtd Fluxos OK], "0" ) & " OK  ·  " &
FORMAT ( [Qtd Fluxos Divergente], "0" ) & " divergente  ·  " &
FORMAT ( [Qtd Fluxos Aguardando], "0" ) & " aguardando"

KPI Subtítulo Periodo =
"Conciliação MDR · Pix · Antecipação  —  competência " &
COALESCE ( SELECTEDVALUE ( dCompetencia[Competencia] ), "todas" )
